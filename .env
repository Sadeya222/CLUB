# CARTO platform credentials (Maps API · CARTO Data Warehouse)
# Exposed to the browser by design — CARTO API Access Tokens are meant for public apps.
# Restrict this token's sources & allowed referrers in CARTO Workspace → Developers → Credentials.
VITE_CARTO_API_BASE_URL=https://gcp-us-east1.api.carto.com
VITE_CARTO_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJhIjoiYWNfd2Y1Mzk1aXkiLCJqdGkiOiI5OTFjMTg4MiJ9.JxHsEbWhoW_9eua-xcEF0-GGLZ3ZdNT6H8yqydQFyzM
VITE_CARTO_CONNECTION=carto_dw

# CARTO Basemaps key — a separate, free key (https://carto.com/basemaps/apikey).
# Since Aug 2026 keyless CARTO tiles are watermarked; the Maps API token above is NOT accepted for tiles.
# Leave empty to use the built-in keyless Esri fallback, or paste the key in Profile → Integrations.
VITE_CARTO_BASEMAPS_KEY=
