# Copy to .env and fill in your CARTO credentials.
# API base URL: CARTO Workspace → Developers → "API Base URL"
VITE_CARTO_API_BASE_URL=https://gcp-us-east1.api.carto.com
# API Access Token with the Maps API enabled for the connection below
VITE_CARTO_ACCESS_TOKEN=your-carto-api-access-token
# Connection name (CARTO Data Warehouse = carto_dw)
VITE_CARTO_CONNECTION=carto_dw
# Free CARTO Basemaps key (https://carto.com/basemaps/apikey) — removes the "API key required" watermark.
# Optional: without it the app falls back to keyless Esri tiles.
VITE_CARTO_BASEMAPS_KEY=
